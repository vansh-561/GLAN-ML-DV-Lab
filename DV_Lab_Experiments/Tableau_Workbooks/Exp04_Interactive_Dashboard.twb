            <connection class='textscan' directory='d:/GLAN ML &amp; DV Lab/DV_Lab_Experiments/Datasets' filename='Exp04_Retail_Dashboard.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.federated.exp04_retail' name='Exp04_Retail_Dashboard.csv' table='[Exp04_Retail_Dashboard.csv#csv]' type='table'>
