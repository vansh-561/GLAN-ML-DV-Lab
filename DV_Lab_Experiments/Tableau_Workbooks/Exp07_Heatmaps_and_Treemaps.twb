      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
    </datasource>
  </datasources>

  <worksheets>
    <worksheet name='Correlation Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0f766e'>Exp 7A: Feature Correlation Matrix Heatmap</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Exp07_Correlation_Matrix' name='federated.exp07_corr' />
          </datasources>
          <datasource-dependencies datasource='federated.exp07_corr'>
            <column datatype='string' name='[Feature_X]' role='dimension' type='nominal' />
            <column datatype='string' name='[Feature_Y]' role='dimension' type='nominal' />
            <column datatype='real' name='[Correlation]' role='measure' type='quantitative' />
            <column-instance column='[Feature_X]' derivation='None' name='[none:Feature_X:nk]' pivot='key' type='nominal' />
            <column-instance column='[Feature_Y]' derivation='None' name='[none:Feature_Y:nk]' pivot='key' type='nominal' />
            <column-instance column='[Correlation]' derivation='Avg' name='[avg:Correlation:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
          <encodings>
            <color column='[federated.exp07_corr].[avg:Correlation:qk]' />
            <text column='[federated.exp07_corr].[avg:Correlation:qk]' />
          </encodings>
          </pane>
        </panes>
        <rows>[federated.exp07_corr].[none:Feature_X:nk]</rows>
        <cols>[federated.exp07_corr].[none:Feature_Y:nk]</cols>
        
      </table>
    </worksheet>
    <worksheet name='Multilevel Treemap'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0f766e'>Exp 7B: Category &gt; Sub-Category Sales Treemap</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Exp07_Multilevel_Sales' name='federated.exp07_tree' />
          </datasources>
          <datasource-dependencies datasource='federated.exp07_tree'>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Sub_Category]' role='dimension' type='nominal' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sub_Category]' derivation='None' name='[none:Sub_Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
          <encodings>
            <color column='[federated.exp07_tree].[none:Category:nk]' />
            <size column='[federated.exp07_tree].[sum:Sales:qk]' />
            <lod column='[federated.exp07_tree].[none:Sub_Category:nk]' />
            <text column='[federated.exp07_tree].[none:Sub_Category:nk]' />
          </encodings>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
        
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Exp 7 Heatmap &amp; Treemap'>
      <style />
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' />
      <zones>
        <zone h='100000' id='2' name='Correlation Heatmap' w='50000' x='0' y='0' />
        <zone h='100000' id='3' name='Multilevel Treemap' w='50000' x='50000' y='0' />
      </zones>
    </dashboard>
  </dashboards>
  <windows>
    <window class='worksheet' name='Correlation Heatmap'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='2147483647'><card type='columns' /></strip>
          <strip size='2147483647'><card type='rows' /></strip>
          <strip size='31'><card type='title' /></strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name='Multilevel Treemap'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='2147483647'><card type='columns' /></strip>
          <strip size='2147483647'><card type='rows' /></strip>
          <strip size='31'><card type='title' /></strip>
        </edge>
      </cards>
    </window>
    <window class='dashboard' maximized='true' name='Exp 7 Heatmap &amp; Treemap'>
      <viewpoints />
      <active id='-1' />
    </window>
  </windows>
</workbook>
