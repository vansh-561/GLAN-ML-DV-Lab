<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2026.3.0' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='Exp02_Messy_Retail' inline='true' name='federated.exp02_clean' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Exp02_Messy_Retail' name='textscan.federated.exp02_clean'>
            <connection class='textscan' directory='d:/GLAN ML &amp; DV Lab/DV_Lab_Experiments/Datasets' filename='Exp02_Messy_Retail.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.federated.exp02_clean' name='Exp02_Messy_Retail.csv' table='[Exp02_Messy_Retail.csv#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='Order_ID' ordinal='0' />
            <column datatype='date' name='Order_Date_Txt' ordinal='1' />
            <column datatype='string' name='Region_Raw' ordinal='2' />
            <column datatype='string' name='Category_Name' ordinal='3' />
            <column datatype='string' name='Product' ordinal='4' />
            <column datatype='string' name='Qty_Text' ordinal='5' />
            <column datatype='real' name='Unit_Price_INR' ordinal='6' />
            <column datatype='real' name='Profit_INR' ordinal='7' />
            <column datatype='string' name='Record_Status' ordinal='8' />
          </columns>
        </relation>
        <metadata-records>
        <metadata-record class='column'>
          <remote-name>Order_ID</remote-name>
          <remote-type>129</remote-type>
          <local-name>[Order_ID]</local-name>
          <parent-name>[Exp02_Messy_Retail.csv]</parent-name>
          <remote-alias>Order_ID</remote-alias>
          <ordinal>0</ordinal>
          <local-type>string</local-type>
          <aggregation>Count</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Order_Date_Txt</remote-name>
          <remote-type>133</remote-type>
          <local-name>[Order_Date_Txt]</local-name>
          <parent-name>[Exp02_Messy_Retail.csv]</parent-name>
          <remote-alias>Order_Date_Txt</remote-alias>
          <ordinal>1</ordinal>
          <local-type>date</local-type>
          <aggregation>Count</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Region_Raw</remote-name>
          <remote-type>129</remote-type>
          <local-name>[Region_Raw]</local-name>
          <parent-name>[Exp02_Messy_Retail.csv]</parent-name>
          <remote-alias>Region_Raw</remote-alias>
          <ordinal>2</ordinal>
          <local-type>string</local-type>
          <aggregation>Count</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Category_Name</remote-name>
          <remote-type>129</remote-type>
          <local-name>[Category_Name]</local-name>
          <parent-name>[Exp02_Messy_Retail.csv]</parent-name>
          <remote-alias>Category_Name</remote-alias>
          <ordinal>3</ordinal>
          <local-type>string</local-type>
          <aggregation>Count</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Product</remote-name>
          <remote-type>129</remote-type>
          <local-name>[Product]</local-name>
          <parent-name>[Exp02_Messy_Retail.csv]</parent-name>
          <remote-alias>Product</remote-alias>
          <ordinal>4</ordinal>
          <local-type>string</local-type>
          <aggregation>Count</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Qty_Text</remote-name>
          <remote-type>129</remote-type>
          <local-name>[Qty_Text]</local-name>
          <parent-name>[Exp02_Messy_Retail.csv]</parent-name>
          <remote-alias>Qty_Text</remote-alias>
          <ordinal>5</ordinal>
          <local-type>string</local-type>
          <aggregation>Count</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Unit_Price_INR</remote-name>
          <remote-type>5</remote-type>
          <local-name>[Unit_Price_INR]</local-name>
          <parent-name>[Exp02_Messy_Retail.csv]</parent-name>
          <remote-alias>Unit_Price_INR</remote-alias>
          <ordinal>6</ordinal>
          <local-type>real</local-type>
          <aggregation>Sum</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Profit_INR</remote-name>
          <remote-type>5</remote-type>
          <local-name>[Profit_INR]</local-name>
          <parent-name>[Exp02_Messy_Retail.csv]</parent-name>
          <remote-alias>Profit_INR</remote-alias>
          <ordinal>7</ordinal>
          <local-type>real</local-type>
          <aggregation>Sum</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Record_Status</remote-name>
          <remote-type>129</remote-type>
          <local-name>[Record_Status]</local-name>
          <parent-name>[Exp02_Messy_Retail.csv]</parent-name>
          <remote-alias>Record_Status</remote-alias>
          <ordinal>8</ordinal>
          <local-type>string</local-type>
          <aggregation>Count</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column datatype='string' name='[Order_ID]' role='dimension' type='nominal' />
      <column datatype='date' name='[Order_Date_Txt]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Region_Raw]' role='dimension' type='nominal' />
      <column datatype='string' name='[Category_Name]' role='dimension' type='nominal' />
      <column datatype='string' name='[Product]' role='dimension' type='nominal' />
      <column datatype='string' name='[Qty_Text]' role='dimension' type='nominal' />
      <column datatype='real' name='[Unit_Price_INR]' role='measure' type='quantitative' />
      <column datatype='real' name='[Profit_INR]' role='measure' type='quantitative' />
      <column datatype='string' name='[Record_Status]' role='dimension' type='nominal' />
      <column caption='Clean_Region' datatype='string' name='[Calc_CleanRegion]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(LEFT(TRIM([Region_Raw]), 1)) + LOWER(MID(TRIM([Region_Raw]), 2))' />
      </column>
      <column caption='Clean_Quantity' datatype='integer' name='[Calc_CleanQty]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(INT([Qty_Text]))' />
      </column>
      <column caption='Total_Revenue' datatype='real' name='[Calc_TotalRev]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(INT([Qty_Text])) * [Unit_Price_INR]' />
      </column>
      <filter class='categorical' column='[federated.exp02_clean].[Order_ID]'>
        <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
          <groupfilter function='level-members' level='[Order_ID]' />
          <groupfilter function='member' level='[Order_ID]' member='%null%' />
        </groupfilter>
      </filter>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
    </datasource>
  </datasources>

  <worksheets>
    <worksheet name='Cleaned Revenue by Region'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0f766e'>Exp 2A: Cleaned Region Total Revenue</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Exp02_Messy_Retail' name='federated.exp02_clean' />
          </datasources>
          <datasource-dependencies datasource='federated.exp02_clean'>
            <column datatype='string' name='[Region_Raw]' role='dimension' type='nominal' />
            <column datatype='string' name='[Qty_Text]' role='dimension' type='nominal' />
            <column datatype='real' name='[Unit_Price_INR]' role='measure' type='quantitative' />
            <column-instance column='[Calc_CleanRegion]' derivation='None' name='[none:Calc_CleanRegion:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_TotalRev]' derivation='Sum' name='[sum:Calc_TotalRev:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          <encodings>
            <color column='[federated.exp02_clean].[none:Calc_CleanRegion:nk]' />
            <text column='[federated.exp02_clean].[sum:Calc_TotalRev:qk]' />
          </encodings>
          </pane>
        </panes>
        <rows>[federated.exp02_clean].[none:Calc_CleanRegion:nk]</rows>
        <cols>[federated.exp02_clean].[sum:Calc_TotalRev:qk]</cols>
        
      </table>
    </worksheet>
    <worksheet name='Cleaned Product Summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0f766e'>Exp 2B: Clean Quantity &amp; Revenue by Product</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Exp02_Messy_Retail' name='federated.exp02_clean' />
          </datasources>
          <datasource-dependencies datasource='federated.exp02_clean'>
            <column datatype='string' name='[Product]' role='dimension' type='nominal' />
            <column datatype='string' name='[Qty_Text]' role='dimension' type='nominal' />
            <column datatype='real' name='[Unit_Price_INR]' role='measure' type='quantitative' />
            <column-instance column='[Product]' derivation='None' name='[none:Product:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_TotalRev]' derivation='Sum' name='[sum:Calc_TotalRev:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          <encodings>
            <color column='[federated.exp02_clean].[none:Product:nk]' />
          </encodings>
          </pane>
        </panes>
        <rows>[federated.exp02_clean].[sum:Calc_TotalRev:qk]</rows>
        <cols>[federated.exp02_clean].[none:Product:nk]</cols>
        
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Exp 2 Data Prep Dashboard'>
      <style />
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' />
      <zones>
        <zone h='100000' id='2' name='Cleaned Revenue by Region' w='50000' x='0' y='0' />
        <zone h='100000' id='3' name='Cleaned Product Summary' w='50000' x='50000' y='0' />
      </zones>
    </dashboard>
  </dashboards>
  <windows>
    <window class='worksheet' name='Cleaned Revenue by Region'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='2147483647'><card type='columns' /></strip>
          <strip size='2147483647'><card type='rows' /></strip>
          <strip size='31'><card type='title' /></strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name='Cleaned Product Summary'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='2147483647'><card type='columns' /></strip>
          <strip size='2147483647'><card type='rows' /></strip>
          <strip size='31'><card type='title' /></strip>
        </edge>
      </cards>
    </window>
    <window class='dashboard' maximized='true' name='Exp 2 Data Prep Dashboard'>
      <viewpoints />
      <active id='-1' />
    </window>
  </windows>
</workbook>
