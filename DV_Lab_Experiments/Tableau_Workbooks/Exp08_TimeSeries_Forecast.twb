<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2026.3.0' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='Exp08_TimeSeries_Sales' inline='true' name='federated.exp08_ts' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Exp08_TimeSeries_Sales' name='textscan.federated.exp08_ts'>
            <connection class='textscan' directory='d:/GLAN ML &amp; DV Lab/DV_Lab_Experiments/Datasets' filename='Exp08_TimeSeries_Sales.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.federated.exp08_ts' name='Exp08_TimeSeries_Sales.csv' table='[Exp08_TimeSeries_Sales.csv#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='date' name='Month_Date' ordinal='0' />
            <column datatype='integer' name='Year' ordinal='1' />
            <column datatype='integer' name='Month_Num' ordinal='2' />
            <column datatype='real' name='Monthly_Sales' ordinal='3' />
            <column datatype='real' name='Stock_Price_Index' ordinal='4' />
          </columns>
        </relation>
        <metadata-records>
        <metadata-record class='column'>
          <remote-name>Month_Date</remote-name>
          <remote-type>133</remote-type>
          <local-name>[Month_Date]</local-name>
          <parent-name>[Exp08_TimeSeries_Sales.csv]</parent-name>
          <remote-alias>Month_Date</remote-alias>
          <ordinal>0</ordinal>
          <local-type>date</local-type>
          <aggregation>Count</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Year</remote-name>
          <remote-type>20</remote-type>
          <local-name>[Year]</local-name>
          <parent-name>[Exp08_TimeSeries_Sales.csv]</parent-name>
          <remote-alias>Year</remote-alias>
          <ordinal>1</ordinal>
          <local-type>integer</local-type>
          <aggregation>Sum</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Month_Num</remote-name>
          <remote-type>20</remote-type>
          <local-name>[Month_Num]</local-name>
          <parent-name>[Exp08_TimeSeries_Sales.csv]</parent-name>
          <remote-alias>Month_Num</remote-alias>
          <ordinal>2</ordinal>
          <local-type>integer</local-type>
          <aggregation>Sum</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Monthly_Sales</remote-name>
          <remote-type>5</remote-type>
          <local-name>[Monthly_Sales]</local-name>
          <parent-name>[Exp08_TimeSeries_Sales.csv]</parent-name>
          <remote-alias>Monthly_Sales</remote-alias>
          <ordinal>3</ordinal>
          <local-type>real</local-type>
          <aggregation>Sum</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>Stock_Price_Index</remote-name>
          <remote-type>5</remote-type>
          <local-name>[Stock_Price_Index]</local-name>
          <parent-name>[Exp08_TimeSeries_Sales.csv]</parent-name>
          <remote-alias>Stock_Price_Index</remote-alias>
          <ordinal>4</ordinal>
          <local-type>real</local-type>
          <aggregation>Sum</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column datatype='date' name='[Month_Date]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[Year]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Month_Num]' role='measure' type='quantitative' />
      <column datatype='real' name='[Monthly_Sales]' role='measure' type='quantitative' />
      <column datatype='real' name='[Stock_Price_Index]' role='measure' type='quantitative' />
      <column caption='3-Month Moving Avg' datatype='real' name='[Calc_MA3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Monthly_Sales]), -2, 0)' />
      </column>

      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
    </datasource>
  </datasources>

  <worksheets>
    <worksheet name='Trend &amp; Forecast Line'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0f766e'>Exp 8A: Monthly Sales Time Series with Linear Trend Line</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Exp08_TimeSeries_Sales' name='federated.exp08_ts' />
          </datasources>
          <datasource-dependencies datasource='federated.exp08_ts'>
            <column datatype='date' name='[Month_Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Monthly_Sales]' role='measure' type='quantitative' />
            <column-instance column='[Month_Date]' derivation='Month-Trunc' name='[tmn:Month_Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Monthly_Sales]' derivation='Sum' name='[sum:Monthly_Sales:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
          <encodings />
          </pane>
        </panes>
        <trend-line-model enable-trend-lines='true' model-type='linear' />
        <rows>[federated.exp08_ts].[sum:Monthly_Sales:qk]</rows>
        <cols>[federated.exp08_ts].[tmn:Month_Date:qk]</cols>
        
      </table>
    </worksheet>
    <worksheet name='3-Month Moving Avg'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0f766e'>Exp 8B: Smoothed 3-Month Moving Average Trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Exp08_TimeSeries_Sales' name='federated.exp08_ts' />
          </datasources>
          <datasource-dependencies datasource='federated.exp08_ts'>
            <column datatype='date' name='[Month_Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Monthly_Sales]' role='measure' type='quantitative' />
            <column-instance column='[Month_Date]' derivation='Month-Trunc' name='[tmn:Month_Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calc_MA3]' derivation='User' name='[usr:Calc_MA3:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
          <encodings />
          </pane>
        </panes>
        <rows>[federated.exp08_ts].[usr:Calc_MA3:qk]</rows>
        <cols>[federated.exp08_ts].[tmn:Month_Date:qk]</cols>
        
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Exp 8 Time Series Dashboard'>
      <style />
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' />
      <zones>
        <zone h='100000' id='2' name='Trend &amp; Forecast Line' w='50000' x='0' y='0' />
        <zone h='100000' id='3' name='3-Month Moving Avg' w='50000' x='50000' y='0' />
      </zones>
    </dashboard>
  </dashboards>
  <windows>
    <window class='worksheet' name='Trend &amp; Forecast Line'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='2147483647'><card type='columns' /></strip>
          <strip size='2147483647'><card type='rows' /></strip>
          <strip size='31'><card type='title' /></strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name='3-Month Moving Avg'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='2147483647'><card type='columns' /></strip>
          <strip size='2147483647'><card type='rows' /></strip>
          <strip size='31'><card type='title' /></strip>
        </edge>
      </cards>
    </window>
    <window class='dashboard' maximized='true' name='Exp 8 Time Series Dashboard'>
      <viewpoints />
      <active id='-1' />
    </window>
  </windows>
</workbook>
