	partition Retail_Dashboard_Partition = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("d:\GLAN ML & DV Lab\DV_Lab_Experiments\Datasets\Exp04_Retail_Dashboard.csv"),[Delimiter=",", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.None]),
