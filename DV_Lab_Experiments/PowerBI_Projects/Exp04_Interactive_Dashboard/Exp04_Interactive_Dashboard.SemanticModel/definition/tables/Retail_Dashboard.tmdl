table Retail_Dashboard
	lineageTag: d1654fb8-50d4-dfb8-47a8-e535e3b68872

	measure 'Total Sales' = SUM(Retail_Dashboard[Sales])
		formatString: #,##0
		lineageTag: 657d71e1-b22c-9c74-9ea3-a0d30199f8a2

	measure 'Total Profit' = SUM(Retail_Dashboard[Profit])
		formatString: #,##0
		lineageTag: 107352d6-bb9f-46a2-5751-05b0ecc2e4f4

	measure 'Margin %' = DIVIDE([Total Profit], [Total Sales], 0)
		formatString: 0.0%
		lineageTag: 32a5a497-ecbb-bbd4-98a7-2192be680a35

	column Order_ID
